<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        windowBackground is set to match HoneyBgLight (0xFFFDFBF7, "Warm Linen").
        This is the color the OS displays BEFORE Compose renders its first frame.
        Without this, the DeviceDefault theme defaults to black, causing the black-screen flash on launch.

        windowIsTranslucent=false: prevents the black window from showing through during startup.
        windowDrawsSystemBarBackgrounds=true: required for enableEdgeToEdge() to work correctly.
        statusBarColor / navigationBarColor = transparent: edge-to-edge with no bar tinting.
    -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#FDFBF7</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>

